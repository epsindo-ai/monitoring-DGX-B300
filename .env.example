# Salin ke .env lalu ganti nilainya (install.sh membuatnya otomatis). Jangan commit file .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ganti-password-ini
PROMETHEUS_RETENTION=30d

# Port di host
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
DCGM_EXPORTER_PORT=9400

# Mode dcgm-exporter: dcgm-embedded (default) atau dcgm-hostengine (pakai nvidia-dcgm host).
# Tambahkan ",portainer" untuk ikut menjalankan Portainer.
COMPOSE_PROFILES=dcgm-embedded

# Override bila perlu menyamakan dengan versi DCGM di host:
# DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.5.2-4.8.1-ubuntu22.04
