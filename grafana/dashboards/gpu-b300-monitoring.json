          "expr": "avg(avg by (gpu) (DCGM_FI_PROF_GR_ENGINE_ACTIVE{job=\"dcgm\",gpu=~\"$gpu\",GPU_I_ID!=\"\"}) or avg by (gpu) (DCGM_FI_PROF_GR_ENGINE_ACTIVE{job=\"dcgm\",gpu=~\"$gpu\",GPU_I_ID=\"\"}))",
