        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(100 * sum by (gpu, GPU_I_ID, GPU_I_PROFILE) (DCGM_FI_DEV_FB_USED{job=\"dcgm\",gpu=~\"$gpu\",GPU_I_ID!=\"\",GPU_I_PROFILE=~\"$mig_profile\"}) / (sum by (gpu, GPU_I_ID, GPU_I_PROFILE) (DCGM_FI_DEV_FB_USED{job=\"dcgm\",gpu=~\"$gpu\",GPU_I_ID!=\"\",GPU_I_PROFILE=~\"$mig_profile\"}) + sum by (gpu, GPU_I_ID, GPU_I_PROFILE) (DCGM_FI_DEV_FB_FREE{job=\"dcgm\",gpu=~\"$gpu\",GPU_I_ID!=\"\",GPU_I_PROFILE=~\"$mig_profile\"})))",
