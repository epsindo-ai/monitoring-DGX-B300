    {
      "type": "table",
      "title": "Layout MIG",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Otomatis terisi saat GPU di-slice MIG (label GPU_I_ID/GPU_I_PROFILE dari dcgm-exporter). Setelah mengubah layout MIG, restart dcgm-exporter.",
      "fieldConfig": {
        "defaults": {
          "noValue": "MIG tidak aktif",
          "custom": {
            "align": "left"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "gpu": 0,
              "GPU_I_PROFILE": 1,
              "Value": 2
            },
            "renameByName": {
              "gpu": "GPU",
              "GPU_I_PROFILE": "Profile",
              "Value": "Jumlah"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (gpu, GPU_I_PROFILE) (DCGM_FI_PROF_GR_ENGINE_ACTIVE{job=\"dcgm\",gpu=~\"$gpu\",GPU_I_ID!=\"\",GPU_I_PROFILE=~\"$mig_profile\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
